{% set currentRoute = app.request.attributes.get('_route') %}

{# Mobile drawer #}
<div class="drawer drawer-end lg:hidden">
    <input id="nav-drawer" type="checkbox" class="drawer-toggle" />

    {# Mobile navbar #}
    <div class="drawer-content">
        <div class="navbar bg-base-100/80 backdrop-blur-sm">
            <div class="flex-1">
                <a class="btn btn-ghost text-xl group gap-2" href="{{ path('homepage') }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         class="w-6 h-6 transition-transform duration-500 group-hover:rotate-[360deg] text-primary">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <span class="font-bold text-gradient">Fatidique</span>
                </a>
            </div>
            <div class="flex-none">
                <label for="nav-drawer" class="btn btn-ghost btn-circle nav-toggle" aria-label="Ouvrir le menu">
                    <svg class="nav-toggle-open fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                        <path d="M64,384H448V341.33H64Zm0-106.67H448V234.67H64ZM64,128v42.67H448V128Z"/>
                    </svg>
                    <svg class="nav-toggle-close fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                        <polygon points="400 145.49 366.51 112 256 222.51 145.49 112 112 145.49 222.51 256 112 366.51 145.49 400 256 289.49 366.51 400 400 366.51 289.49 256 400 145.49"/>
                    </svg>
                </label>
            </div>
        </div>
    </div>

    {# Mobile drawer side panel #}
    <div class="drawer-side z-50">
        <label for="nav-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
        <ul class="menu p-4 w-72 min-h-full bg-base-200 text-base-content gap-1">
            <li class="menu-title flex flex-row items-center gap-2 mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-primary">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                Navigation
            </li>
            <li class="animate-fade-in-up" style="animation-delay: 50ms;">
                <a href="{{ path('homepage') }}" class="{{ currentRoute == 'homepage' ? 'active' : '' }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                    </svg>
                    Home
                </a>
            </li>
            <li class="animate-fade-in-up" style="animation-delay: 100ms;">
                <a href="{{ path('explore') }}" class="{{ currentRoute == 'explore' ? 'active' : '' }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                    </svg>
                    Explorer
                </a>
            </li>
            <li class="animate-fade-in-up" style="animation-delay: 150ms;">
                <a href="{{ path('agenda') }}" class="{{ currentRoute == 'agenda' ? 'active' : '' }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                    </svg>
                    Agenda
                </a>
            </li>
            <li class="animate-fade-in-up" style="animation-delay: 200ms;">
                <a href="{{ path('stats') }}" class="{{ currentRoute == 'stats' ? 'active' : '' }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                    </svg>
                    Stats
                </a>
            </li>
            <li class="mt-4 animate-fade-in-up" style="animation-delay: 250ms;">
                <a href="{{ path('event_create') }}" class="btn btn-primary btn-shine gap-2 {{ currentRoute == 'event_create' ? 'btn-active' : '' }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Créer un compteur
                </a>
            </li>
        </ul>
    </div>
</div>

{# Desktop navbar #}
<div class="navbar bg-base-100/80 backdrop-blur-sm hidden lg:flex">
    <div class="flex-1">
        <a class="btn btn-ghost text-xl group gap-2" href="{{ path('homepage') }}">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                 class="w-6 h-6 transition-transform duration-500 group-hover:rotate-[360deg] text-primary">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span class="font-bold text-gradient">Fatidique</span>
        </a>
    </div>
    <div class="flex-none">
        <ul class="menu menu-horizontal px-1 gap-1">
            <li>
                <a href="{{ path('homepage') }}" class="hover-wiggle {{ currentRoute == 'homepage' ? 'active' : '' }}">
                    <div class="indicator">
                        {% if currentRoute == 'homepage' %}
                        <span class="indicator-item badge badge-xs badge-primary animate-pulse"></span>
                        {% endif %}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                             class="w-5 h-5 transition-transform group-hover:scale-110">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                        </svg>
                    </div>
                    Home
                </a>
            </li>
            <li>
                <a href="{{ path('explore') }}" class="hover-wiggle {{ currentRoute == 'explore' ? 'active' : '' }}">
                    <div class="indicator">
                        {% if currentRoute == 'explore' %}
                        <span class="indicator-item badge badge-xs badge-primary animate-pulse"></span>
                        {% endif %}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                             class="w-5 h-5 transition-transform group-hover:scale-110">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                        </svg>
                    </div>
                    Explorer
                </a>
            </li>
            <li>
                <a href="{{ path('agenda') }}" class="hover-wiggle {{ currentRoute == 'agenda' ? 'active' : '' }}">
                    <div class="indicator">
                        {% if currentRoute == 'agenda' %}
                        <span class="indicator-item badge badge-xs badge-primary animate-pulse"></span>
                        {% endif %}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                             class="w-5 h-5 transition-transform group-hover:scale-110">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                        </svg>
                    </div>
                    Agenda
                </a>
            </li>
            <li>
                <a href="{{ path('stats') }}" class="hover-wiggle {{ currentRoute == 'stats' ? 'active' : '' }}">
                    <div class="indicator">
                        {% if currentRoute == 'stats' %}
                        <span class="indicator-item badge badge-xs badge-primary animate-pulse"></span>
                        {% endif %}
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                             class="w-5 h-5 transition-transform group-hover:scale-110">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
                        </svg>
                    </div>
                    Stats
                </a>
            </li>
            <li class="ml-2">
                <a href="{{ path('event_create') }}"
                   class="btn btn-primary btn-sm btn-shine gap-2 {{ currentRoute == 'event_create' ? 'btn-active' : '' }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                         class="w-4 h-4 transition-transform group-hover:rotate-90 duration-300">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Créer
                </a>
            </li>
        </ul>
    </div>
</div>
