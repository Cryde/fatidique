{% extends 'base.html.twig' %}

{% block body %}
    {# Hero Section with floating decorations #}
    <div class="hero min-h-64 md:min-h-80 mt-6 md:mt-10 mx-2 md:mx-4 rounded-xl md:rounded-2xl relative overflow-hidden"
         style="background-image: url({{ asset('assets/images/bg-quote.webp') }});">
        <div class="hero-overlay bg-opacity-60 rounded-xl md:rounded-2xl"></div>

        {# Floating emoji decorations #}
        <div class="absolute inset-0 pointer-events-none overflow-hidden">
            <span class="absolute top-8 left-[10%] text-2xl md:text-3xl animate-float-slow opacity-60">&#x23F0;</span>
            <span class="absolute top-16 right-[15%] text-xl md:text-2xl animate-float-medium opacity-50 delay-200">&#x1F3AF;</span>
            <span class="absolute bottom-12 left-[20%] text-2xl md:text-3xl animate-float-fast opacity-40 delay-100">&#x1F389;</span>
            <span class="absolute bottom-8 right-[25%] text-xl md:text-2xl animate-float-slow opacity-50 delay-300">&#x2728;</span>
            <span class="absolute top-1/2 left-[5%] text-lg md:text-xl animate-float-medium opacity-30 delay-150">&#x1F4C5;</span>
            <span class="absolute top-1/3 right-[8%] text-lg md:text-xl animate-float-fast opacity-35 delay-250">&#x1F552;</span>
        </div>

        <div class="hero-content text-center text-neutral-content px-4 py-8 z-10">
            <div class="max-w-lg">
                <h1 class="mb-3 md:mb-5 text-3xl md:text-5xl font-bold animate-fade-in">
                    <span class="inline-block animate-bounce-subtle">F</span><span class="inline-block animate-bounce-subtle delay-75">a</span><span class="inline-block animate-bounce-subtle delay-100">t</span><span class="inline-block animate-bounce-subtle delay-150">i</span><span class="inline-block animate-bounce-subtle delay-200">d</span><span class="inline-block animate-bounce-subtle delay-250">i</span><span class="inline-block animate-bounce-subtle delay-300">q</span><span class="inline-block animate-bounce-subtle delay-350">u</span><span class="inline-block animate-bounce-subtle delay-400">e</span>
                </h1>
                <p class="mb-4 md:mb-5 text-base md:text-lg opacity-90 animate-fade-in delay-500">
                    Parce que chaque moment fatidique a besoin de <strong class="text-primary-content">son compteur</strong>...
                </p>
                <a class="btn btn-primary btn-md md:btn-lg btn-shine group animate-fade-in delay-600" href="{{ path('event_create') }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         class="w-4 h-4 md:w-5 md:h-5 transition-transform duration-300 group-hover:rotate-90">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Créer un compteur
                </a>
            </div>
        </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 mt-16">
        {# Latest Events Section #}
        {% if lastEvents|length > 0 %}
        <div class="mb-16 animate-fade-in">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-3 group">
                <div class="icon-container group-hover:scale-110 transition-transform">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         class="w-6 h-6 text-primary animate-sparkle">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
                    </svg>
                </div>
                Nouveautés
                <span class="badge badge-primary badge-animated">{{ lastEvents|length }}</span>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for event in lastEvents %}
                    {{ _self.event_card(event, false, loop.index0) }}
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# Most Liked Events Section #}
        {% if mostLikedEvents|length > 0 %}
        <div class="mb-16 animate-fade-in">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-3 group">
                <div class="icon-container group-hover:scale-110 transition-transform" style="background: oklch(0.9 0.15 15 / 0.15);">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         class="w-6 h-6 text-error animate-pulse">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                    </svg>
                </div>
                Les plus aimés
                <span class="badge badge-error badge-animated">{{ mostLikedEvents|length }}</span>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for event in mostLikedEvents %}
                    {{ _self.event_card(event, true, loop.index0) }}
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# Coming Soon Events Section #}
        {% if almostEndedEvents|length > 0 %}
        <div class="mb-16 animate-fade-in">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-3 group">
                <div class="icon-container group-hover:scale-110 transition-transform" style="background: oklch(0.8 0.15 80 / 0.15);">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         class="w-6 h-6 text-warning animate-bounce-subtle">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                </div>
                Bientôt !
                <span class="badge badge-warning badge-animated">{{ almostEndedEvents|length }}</span>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for event in almostEndedEvents %}
                    {{ _self.event_card(event, false, loop.index0) }}
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# Explore More CTA #}
        <div class="flex justify-center mb-8 animate-fade-in">
            <a href="{{ path('explore') }}" class="btn btn-outline btn-primary btn-shine group gap-2">
                Voir tous les événements
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                     class="w-4 h-4 transition-transform group-hover:translate-x-1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
            </a>
        </div>
    </div>
{% endblock %}

{% macro event_card(event, showLikes = false, index = 0) %}
    {% set theme = constant('App\\Entity\\Event::THEMES')[event.themeOrDefault] %}
    {% set daysLeft = ((event.date.timestamp - date().timestamp) / 86400)|round(0, 'floor') %}

    <a href="{{ path('event_view', {slug: event.slug}) }}"
       class="card card-compact card-hover-lift shimmer-hover overflow-hidden animate-fade-in-up"
       style="animation-delay: {{ index * 100 }}ms;">
        <div class="theme-preview theme-{{ event.themeOrDefault }} p-6 min-h-32 flex flex-col justify-between relative">
            <div class="flex justify-between items-start">
                {# Theme emoji with hover bounce #}
                <span class="text-3xl transition-transform hover:scale-125 hover:rotate-12 cursor-default">
                    {{ theme.emoji }}
                </span>

                <div class="flex gap-2">
                    {# Likes badge #}
                    {% if showLikes and event.likesCount > 0 %}
                    <span class="badge badge-ghost bg-white/20 backdrop-blur-sm text-white border-0 gap-1 transition-transform hover:scale-110">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 animate-pulse">
                            <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
                        </svg>
                        {{ event.likesCount }}
                    </span>
                    {% endif %}

                    {# Days remaining badge with urgency styling #}
                    <span class="badge badge-ghost bg-white/20 backdrop-blur-sm text-white border-0
                                 {% if daysLeft == 0 %}animate-pulse bg-error/40{% elseif daysLeft == 1 %}animate-pulse bg-warning/40{% endif %}">
                        {% if daysLeft == 0 %}
                            <span class="mr-1">&#x1F525;</span> Aujourd'hui !
                        {% elseif daysLeft == 1 %}
                            <span class="mr-1">&#x26A1;</span> Demain !
                        {% elseif daysLeft < 0 %}
                            Terminé
                        {% else %}
                            {{ daysLeft }} jours
                        {% endif %}
                    </span>
                </div>
            </div>

            <h3 class="card-title text-lg mt-4 line-clamp-2">{{ event.label }}</h3>
        </div>
    </a>
{% endmacro %}
