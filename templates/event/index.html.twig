{% extends 'base.html.twig' %}

{% block body %}
    <div class="hero min-h-64 md:min-h-80 mt-6 md:mt-10 mx-2 md:mx-4 rounded-xl md:rounded-2xl" style="background-image: url({{ asset('assets/images/bg-quote.webp') }});">
        <div class="hero-overlay bg-opacity-60 rounded-xl md:rounded-2xl"></div>
        <div class="hero-content text-center text-neutral-content px-4 py-8">
            <div class="max-w-md">
                <h1 class="mb-3 md:mb-5 text-3xl md:text-5xl font-bold">Fatidique</h1>
                <p class="mb-4 md:mb-5 text-base md:text-lg opacity-90">Parce que chaque moment fatidique a besoin de <strong>son compteur</strong>...</p>
                <a class="btn btn-primary btn-md md:btn-lg" href="{{ path('event_create') }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 md:w-5 md:h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Créer un compteur
                </a>
            </div>
        </div>
    </div>

    <div class="max-w-5xl mx-auto px-4 mt-16">
        {% if lastEvents|length > 0 %}
        <div class="mb-16">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
                </svg>
                Nouveautés
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for event in lastEvents %}
                    {{ _self.event_card(event) }}
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {% if mostLikedEvents|length > 0 %}
        <div class="mb-16">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                </svg>
                Les plus aimés
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for event in mostLikedEvents %}
                    {{ _self.event_card(event, true) }}
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {% if almostEndedEvents|length > 0 %}
        <div class="mb-16">
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                Bientôt !
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for event in almostEndedEvents %}
                    {{ _self.event_card(event) }}
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>
{% endblock %}

{% macro event_card(event, showLikes = false) %}
    {% set theme = constant('App\\Entity\\Event::THEMES')[event.themeOrDefault] %}
    {% set daysLeft = ((event.date.timestamp - date().timestamp) / 86400)|round(0, 'floor') %}
    <a href="{{ path('event_view', {slug: event.slug}) }}"
       class="card card-compact shadow-lg hover:shadow-xl transition-all hover:scale-[1.02] overflow-hidden">
        <div class="theme-preview theme-{{ event.themeOrDefault }} p-6 min-h-32 flex flex-col justify-between">
            <div class="flex justify-between items-start">
                <span class="text-3xl">{{ theme.emoji }}</span>
                <div class="flex gap-2">
                    {% if showLikes and event.likesCount > 0 %}
                    <span class="badge badge-ghost bg-white/20 backdrop-blur-sm text-white border-0 gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3">
                            <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
                        </svg>
                        {{ event.likesCount }}
                    </span>
                    {% endif %}
                    <span class="badge badge-ghost bg-white/20 backdrop-blur-sm text-white border-0">
                        {% if daysLeft == 0 %}
                            Aujourd'hui !
                        {% elseif daysLeft == 1 %}
                            Demain !
                        {% elseif daysLeft < 0 %}
                            Terminé
                        {% else %}
                            {{ daysLeft }} jours
                        {% endif %}
                    </span>
                </div>
            </div>
            <h3 class="card-title text-lg mt-4 line-clamp-2">{{ event.label }}</h3>
        </div>
    </a>
{% endmacro %}
