{% extends 'base.html.twig' %}

{% block title %}Créer un compteur fatidique{% endblock %}
{% block description %}Créer un compteur fatidique en remplissant le formulaire ci dessous{% endblock %}

{% block body %}
    {# Inspirational Quote Section #}
    <figure class="max-w-screen-md mx-auto text-center py-8 px-4 animate-fade-in">
        <svg class="w-10 h-10 mx-auto mb-3 text-primary/60 animate-bounce-subtle" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 18 14">
            <path d="M6 0H2a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h4v1a3 3 0 0 1-3 3H2a1 1 0 0 0 0 2h1a5.006 5.006 0 0 0 5-5V2a2 2 0 0 0-2-2Zm10 0h-4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h4v1a3 3 0 0 1-3 3h-1a1 1 0 0 0 0 2h1a5.006 5.006 0 0 0 5-5V2a2 2 0 0 0-2-2Z"/>
        </svg>
        <blockquote>
            <p class="text-2xl italic font-medium text-gradient">"La distance Grappille le temps."</p>
        </blockquote>
        <figcaption class="flex items-center justify-center mt-6 space-x-3 rtl:space-x-reverse">
            <div class="avatar">
                <div class="w-8 rounded-full ring ring-primary ring-offset-base-100 ring-offset-1 hover:scale-110 transition-transform">
                    <img src="https://images.mubicdn.net/images/cast_member/584751/cache-633793-1610839605/image-w856.jpg?size=240x"
                         alt="profile picture">
                </div>
            </div>
            <div class="flex items-center divide-x-2 rtl:divide-x-reverse divide-base-300">
                <cite class="pe-3 font-medium">Eugène Guillevic</cite>
                <cite class="ps-3 text-sm opacity-70">Poète français</cite>
            </div>
        </figcaption>
    </figure>

    {# Progress Steps #}
    <div class="max-w-2xl mx-auto px-4 mb-8 animate-fade-in delay-200">
        <ul class="steps steps-horizontal w-full steps-playful">
            <li class="step step-primary" data-content="&#x1F4C5;">Quand ?</li>
            <li class="step" data-content="&#x270F;&#xFE0F;">Quoi ?</li>
            <li class="step" data-content="&#x1F3A8;">Style</li>
            <li class="step" data-content="&#x1F680;">Go !</li>
        </ul>
    </div>

    <div class="grid md:grid-cols-4 sm:grid-cols-1 mb-20 px-4 md:px-0">
        <div class="md:col-start-2 md:col-span-2">
            {{ form_start(form) }}

            {# Date Field #}
            <fieldset class="fieldset group animate-fade-in-up" data-step="0" style="animation-delay: 100ms;">
                <legend class="fieldset-legend flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         class="w-4 h-4 text-primary group-focus-within:animate-bounce-subtle">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                    </svg>
                    Date du moment fatidique
                </legend>
                <div class="join w-full">
                    {{ form_widget(form.date, {attr: {class: 'input input-bordered join-item w-full input-glow focus:input-primary transition-all duration-300'}}) }}
                    <span class="join-item btn btn-square btn-ghost pointer-events-none bg-base-200">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 opacity-50">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                        </svg>
                    </span>
                </div>
            </fieldset>

            {# Date Only Toggle #}
            <fieldset class="fieldset animate-fade-in-up" data-step="0" style="animation-delay: 150ms;">
                <label class="label cursor-pointer justify-start gap-3 p-4 bg-base-200 rounded-lg hover:bg-base-300 transition-colors group">
                    <span class="label-text flex items-center gap-2">
                        <span class="text-xl group-hover:animate-bounce-subtle">&#x1F550;</span>
                        N'afficher que la date, sans l'heure
                    </span>
                    {{ form_widget(form.isDateOnly, {attr: {class: 'toggle toggle-primary'}}) }}
                </label>
            </fieldset>

            {# Title Field #}
            <fieldset class="fieldset group animate-fade-in-up" data-step="1" style="animation-delay: 200ms;">
                <legend class="fieldset-legend flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         class="w-4 h-4 text-primary group-focus-within:animate-sparkle">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                    </svg>
                    Le titre de cet événement
                </legend>
                {{ form_widget(form.label, {attr: {
                    class: 'input input-bordered w-full input-glow focus:input-primary transition-all duration-300',
                    placeholder: 'Ex: Mon anniversaire, Vacances d\'été...'
                }}) }}
            </fieldset>

            {# Description Field #}
            <fieldset class="fieldset group animate-fade-in-up" data-step="1" style="animation-delay: 250ms;">
                <legend class="fieldset-legend flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         class="w-4 h-4 text-primary group-focus-within:animate-sparkle">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
                    </svg>
                    Une petite description
                    <span class="badge badge-ghost badge-sm">optionnel</span>
                </legend>
                {{ form_widget(form.description, {attr: {
                    class: 'textarea textarea-bordered h-24 w-full textarea-glow focus:textarea-primary transition-all duration-300',
                    placeholder: 'Décrivez votre événement...'
                }}) }}
            </fieldset>

            {# Theme Picker #}
            <fieldset class="fieldset animate-fade-in-up" data-step="2" style="animation-delay: 300ms;">
                <legend class="fieldset-legend flex items-center gap-2 mb-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         class="w-4 h-4 text-primary">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 0 0 5.304 0l6.401-6.402M6.75 21A3.75 3.75 0 0 1 3 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 0 0 3.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008Z" />
                    </svg>
                    Thème
                    <span class="badge badge-primary badge-sm animate-pulse">Choisissez l'ambiance</span>
                </legend>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    {% for key, theme in constant('App\\Entity\\Event::THEMES') %}
                    <label class="theme-option-enhanced cursor-pointer relative animate-fade-in-up" style="animation-delay: {{ loop.index0 * 50 }}ms;">
                        <input type="radio" name="{{ form.theme.vars.full_name }}" value="{{ key }}"
                               class="hidden peer" {{ form.theme.vars.value == key ? 'checked' : '' }}>
                        <div class="theme-preview theme-{{ key }}
                                    peer-checked:ring-4 peer-checked:ring-primary peer-checked:ring-offset-2 peer-checked:scale-105
                                    rounded-xl p-4 text-center transition-all duration-300
                                    hover:shadow-lg relative overflow-hidden group">
                            {# Shine effect #}
                            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent
                                        translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700 pointer-events-none"></div>

                            <span class="text-3xl block mb-2 group-hover:scale-125 transition-transform duration-300">
                                {{ theme.emoji }}
                            </span>
                            <p class="text-sm font-medium">{{ theme.label }}</p>
                        </div>

                        {# Selected checkmark. Sibling of the input, not nested in .theme-preview:
                           peer-checked: compiles to a sibling combinator and cannot reach descendants. #}
                        <div class="absolute top-2 right-2 opacity-0 peer-checked:opacity-100 transition-opacity pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-primary">
                                <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" />
                            </svg>
                        </div>
                    </label>
                    {% endfor %}
                </div>
                {% do form.theme.setRendered %}
            </fieldset>

            {# Private Toggle #}
            <fieldset class="fieldset animate-fade-in-up" data-step="3" style="animation-delay: 350ms;">
                <label class="label cursor-pointer justify-start gap-3 p-4 bg-base-200 rounded-lg hover:bg-base-300 transition-colors group">
                    <span class="label-text flex items-center gap-2">
                        <span class="text-xl group-hover:animate-wiggle">&#x1F512;</span>
                        Privé ?
                        <div class="tooltip tooltip-right" data-tip="Seuls ceux avec le lien pourront voir">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 opacity-50">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                            </svg>
                        </div>
                    </span>
                    {{ form_widget(form.private, {attr: {class: 'toggle toggle-primary'}}) }}
                </label>
            </fieldset>

            {# Submit Button #}
            <div class="flex justify-end mt-8 animate-fade-in-up" style="animation-delay: 400ms;">
                <button type="submit" class="btn btn-primary btn-lg btn-shine group gap-2 relative overflow-hidden">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         class="w-6 h-6 transition-transform group-hover:translate-x-1 group-hover:scale-110">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                    </svg>
                    <span class="group-hover:tracking-wider transition-all">Enregistrer</span>
                    <span class="absolute -top-1 -right-1 text-sm opacity-0 group-hover:opacity-100 transition-opacity">&#x2728;</span>
                </button>
            </div>

            {{ form_end(form) }}

            {# Info Alert #}
            <div role="alert" class="alert mt-12 animate-fade-in-up" style="animation-delay: 450ms;">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     class="stroke-info shrink-0 w-6 h-6">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>
                    <strong>&#x1F4A1; Astuce :</strong> Si vous marquez le moment fatidique en 'privé', celui-ci n'apparaîtra pas sur la page d'accueil.
                    Seuls les personnes avec le lien pourront y avoir accès.
                </span>
            </div>
        </div>
    </div>
{% endblock %}
