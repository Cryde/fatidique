{% extends 'base.html.twig' %}

{% block title %}{{ event.label }}{% endblock %}

{% block body_class %}theme-{{ event.themeOrDefault }}{% endblock %}

{%- block description -%}
    {%- set description = event.description|replace({"\n":' ', "\r":' '})[:156] ~ ' ...' -%}
    {{ description | length > 10? description : parent() }}
{%- endblock %}

{% block body %}
    <div class="grid md:grid-cols-4 sm:grid-cols-1 mt-20 px-4 md:px-0">
        <div class="md:col-start-2 md:col-span-2">
            <h1 class="text-2xl">{{ event.label }}</h1>
            <div class="divider mt-1"></div>
        </div>
    </div>

    <div id="clock"
         data-datetime="{{ event.date | date(constant('\DATE_ATOM')) }}"
         data-created="{{ event.created ? event.created | date(constant('\DATE_ATOM')) : '' }}"
         data-date-only="{{ event.isDateOnly ? '1' : '0' }}"
         data-label="{{ event.label }}"></div>

    <div id="celebration" class="hidden text-center mt-16 mb-20 px-4">
        <div class="text-6xl md:text-8xl mb-6">{{ constant('App\\Entity\\Event::THEMES')[event.themeOrDefault]['emoji'] }}</div>
        <h2 class="text-3xl md:text-5xl font-bold mb-4">C'est le moment !</h2>
        <p class="text-xl opacity-70">Le compte à rebours est terminé</p>
    </div>

    <div id="countdown" class="invisible flex flex-wrap justify-center gap-4 mt-16 mb-20 px-4">
        <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
            <span class="countdown font-mono text-5xl md:text-6xl">
                <span id="years" style="--value:0;"></span>
            </span>
            <span class="text-sm mt-2 opacity-70">années</span>
        </div>
        <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
            <span class="countdown font-mono text-5xl md:text-6xl">
                <span id="months" style="--value:0;"></span>
            </span>
            <span class="text-sm mt-2 opacity-70">mois</span>
        </div>
        <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
            <span class="countdown font-mono text-5xl md:text-6xl">
                <span id="days" style="--value:0;"></span>
            </span>
            <span class="text-sm mt-2 opacity-70">jours</span>
        </div>
        {% if not event.isDateOnly %}
        <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
            <span class="countdown font-mono text-5xl md:text-6xl">
                <span id="hours" style="--value:0;"></span>
            </span>
            <span class="text-sm mt-2 opacity-70">heures</span>
        </div>
        <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
            <span class="countdown font-mono text-5xl md:text-6xl">
                <span id="minutes" style="--value:0;"></span>
            </span>
            <span class="text-sm mt-2 opacity-70">minutes</span>
        </div>
        <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
            <span class="countdown font-mono text-5xl md:text-6xl">
                <span id="secondes" style="--value:0;"></span>
            </span>
            <span class="text-sm mt-2 opacity-70">secondes</span>
        </div>
        {% endif %}
    </div>

    <div id="fun-stats" class="invisible text-center mt-8 mb-8 px-4 max-w-2xl mx-auto">
        <p class="text-lg opacity-80">
            Soit <span id="total-hours" class="font-bold">0</span> heures,
            ou <span id="total-seconds" class="font-bold">0</span> secondes !
        </p>
        <div class="flex flex-wrap justify-center gap-3 mt-4">
            <span class="badge badge-lg gap-1">😴 <span id="sleeps" class="font-bold">0</span> dodos</span>
            <span class="badge badge-lg gap-1">☕ <span id="coffees" class="font-bold">0</span> cafés</span>
            <span class="badge badge-lg gap-1">📺 <span id="episodes" class="font-bold">0</span> épisodes</span>
            <span class="badge badge-lg gap-1">🍕 <span id="pizzas" class="font-bold">0</span> pizzas</span>
            <span class="badge badge-lg gap-1">🎵 <span id="songs" class="font-bold">0</span> chansons</span>
            <span class="badge badge-lg gap-1">🚶 <span id="walks" class="font-bold">0</span> km à pied</span>
        </div>
    </div>

    <div class="text-center mb-16 px-4">
        <p class="text-sm opacity-60 mb-3">Partager ce compte à rebours</p>
        <div class="flex flex-wrap justify-center gap-2">
            <button id="copy-link" class="btn btn-sm btn-outline gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9.75a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                </svg>
                <span>Copier le lien</span>
            </button>
            <a href="https://wa.me/?text={{ url('event_view', {slug: event.slug})|url_encode }}" target="_blank" class="btn btn-sm btn-outline gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                WhatsApp
            </a>
            <a href="https://twitter.com/intent/tweet?url={{ url('event_view', {slug: event.slug})|url_encode }}&text={{ ('Compte à rebours : ' ~ event.label)|url_encode }}" target="_blank" class="btn btn-sm btn-outline gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                X
            </a>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ url('event_view', {slug: event.slug})|url_encode }}" target="_blank" class="btn btn-sm btn-outline gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                Facebook
            </a>
        </div>
    </div>

    <div class="grid md:grid-cols-4 sm:grid-cols-1 mt-20 px-4 md:px-0">
        <div class="md:col-start-2 md:col-span-2">
            {% if event.description %}
                <h4 class="text-md">Détails</h4>
                <div class="divider mt-1"></div>
                <p>
                    {{ event.description | nl2br }}
                    <br/><br/>
                </p>
            {% endif %}
        </div>
    </div>
{% endblock %}
