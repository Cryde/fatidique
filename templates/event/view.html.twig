{% extends 'base.html.twig' %}

{% block title %}{{ event.label }}{% endblock %}

{% block body_class %}theme-{{ event.themeOrDefault }}{% endblock %}

{%- block description -%}
    {%- set description = event.description|replace({"\n":' ', "\r":' '})[:156] ~ ' ...' -%}
    {{ description | length > 10? description : parent() }}
{%- endblock %}

{% block body %}
    <div class="grid md:grid-cols-4 sm:grid-cols-1 mt-20 px-4 md:px-0">
        <div class="md:col-start-2 md:col-span-2">
            <h1 class="text-2xl">{{ event.label }}</h1>
            {% if event.author %}
                <p class="text-sm opacity-60 mt-1 flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                    </svg>
                    par {{ event.author }}
                </p>
            {% endif %}
            <div class="divider mt-1"></div>
        </div>
    </div>

    <div id="clock"
         data-datetime="{{ event.date | date('Y-m-d\\TH:i:sP') }}"
         data-created="{{ event.created ? event.created | date('Y-m-d\\TH:i:sP') : '' }}"
         data-date-only="{{ event.isDateOnly ? '1' : '0' }}"
         data-label="{{ event.label }}"></div>

    <div id="celebration" class="hidden text-center mt-16 mb-20 px-4">
        <div class="text-6xl md:text-8xl mb-6">{{ constant('App\\Entity\\Event::THEMES')[event.themeOrDefault]['emoji'] }}</div>
        <h2 class="text-3xl md:text-5xl font-bold mb-4">C'est le moment !</h2>
        <p class="text-xl opacity-70">Le compte à rebours est terminé</p>
    </div>

    <div id="milestones" class="hidden flex justify-center gap-2 mb-4 px-4">
        <span id="badge-100" class="hidden badge badge-lg badge-warning gap-1 animate-pulse">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
            </svg>
            100 jours !
        </span>
        <span id="badge-30" class="hidden badge badge-lg badge-info gap-1 animate-pulse">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path fill-rule="evenodd" d="M8.603 3.799A4.49 4.49 0 0 1 12 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 0 1 3.498 1.307 4.491 4.491 0 0 1 1.307 3.497A4.49 4.49 0 0 1 21.75 12a4.49 4.49 0 0 1-1.549 3.397 4.491 4.491 0 0 1-1.307 3.497 4.491 4.491 0 0 1-3.497 1.307A4.49 4.49 0 0 1 12 21.75a4.49 4.49 0 0 1-3.397-1.549 4.49 4.49 0 0 1-3.498-1.306 4.491 4.491 0 0 1-1.307-3.498A4.49 4.49 0 0 1 2.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 0 1 1.307-3.497 4.49 4.49 0 0 1 3.497-1.307Zm7.007 6.387a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" />
            </svg>
            30 jours !
        </span>
        <span id="badge-7" class="hidden badge badge-lg badge-secondary gap-1 animate-pulse">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path fill-rule="evenodd" d="M12.963 2.286a.75.75 0 0 0-1.071-.136 9.742 9.742 0 0 0-3.539 6.176 7.547 7.547 0 0 1-1.705-1.715.75.75 0 0 0-1.152-.082A9 9 0 1 0 15.68 4.534a7.46 7.46 0 0 1-2.717-2.248ZM15.75 14.25a3.75 3.75 0 1 1-7.313-1.172c.628.465 1.35.81 2.133 1a5.99 5.99 0 0 1 1.925-3.546 3.75 3.75 0 0 1 3.255 3.718Z" clip-rule="evenodd" />
            </svg>
            1 semaine !
        </span>
        <span id="badge-1" class="hidden badge badge-lg badge-error gap-1 animate-bounce">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 6a.75.75 0 0 0-1.5 0v6c0 .414.336.75.75.75h4.5a.75.75 0 0 0 0-1.5h-3.75V6Z" clip-rule="evenodd" />
            </svg>
            Dernier jour !
        </span>
    </div>

    <div id="countdown" class="invisible flex flex-wrap justify-center gap-4 mt-16 mb-20 px-4">
        <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
            <span class="countdown font-mono text-5xl md:text-6xl">
                <span id="years" style="--value:0;"></span>
            </span>
            <span class="text-sm mt-2 opacity-70">années</span>
        </div>
        <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
            <span class="countdown font-mono text-5xl md:text-6xl">
                <span id="months" style="--value:0;"></span>
            </span>
            <span class="text-sm mt-2 opacity-70">mois</span>
        </div>
        <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
            <span class="countdown font-mono text-5xl md:text-6xl">
                <span id="days" style="--value:0;"></span>
            </span>
            <span class="text-sm mt-2 opacity-70">jours</span>
        </div>
        {% if not event.isDateOnly %}
        <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
            <span class="countdown font-mono text-5xl md:text-6xl">
                <span id="hours" style="--value:0;"></span>
            </span>
            <span class="text-sm mt-2 opacity-70">heures</span>
        </div>
        <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
            <span class="countdown font-mono text-5xl md:text-6xl">
                <span id="minutes" style="--value:0;"></span>
            </span>
            <span class="text-sm mt-2 opacity-70">minutes</span>
        </div>
        <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
            <span class="countdown font-mono text-5xl md:text-6xl">
                <span id="secondes" style="--value:0;"></span>
            </span>
            <span class="text-sm mt-2 opacity-70">secondes</span>
        </div>
        {% endif %}
    </div>

    <div id="fun-stats" class="invisible text-center mt-8 mb-8 px-4 max-w-2xl mx-auto">
        <p class="text-lg opacity-80">
            Soit <span id="total-hours" class="font-bold">0</span> heures,
            ou <span id="total-seconds" class="font-bold">0</span> secondes !
        </p>
        <div class="flex flex-wrap justify-center gap-3 mt-4">
            <span class="badge badge-lg gap-1">😴 <span id="sleeps" class="font-bold">0</span> dodos</span>
            <span class="badge badge-lg gap-1">☕ <span id="coffees" class="font-bold">0</span> cafés</span>
            <span class="badge badge-lg gap-1">📺 <span id="episodes" class="font-bold">0</span> épisodes</span>
            <span class="badge badge-lg gap-1">🍕 <span id="pizzas" class="font-bold">0</span> pizzas</span>
            <span class="badge badge-lg gap-1">🎵 <span id="songs" class="font-bold">0</span> chansons</span>
            <span class="badge badge-lg gap-1">🚶 <span id="walks" class="font-bold">0</span> km à pied</span>
        </div>
    </div>

    <div id="countup" class="hidden invisible">
        <p class="text-center text-xl opacity-70 mb-6 px-4">Ça fait déjà...</p>
        <div class="flex flex-wrap justify-center gap-4 mb-20 px-4">
            <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
                <span class="countdown font-mono text-5xl md:text-6xl">
                    <span id="up-years" style="--value:0;"></span>
                </span>
                <span class="text-sm mt-2 opacity-70">années</span>
            </div>
            <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
                <span class="countdown font-mono text-5xl md:text-6xl">
                    <span id="up-months" style="--value:0;"></span>
                </span>
                <span class="text-sm mt-2 opacity-70">mois</span>
            </div>
            <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
                <span class="countdown font-mono text-5xl md:text-6xl">
                    <span id="up-days" style="--value:0;"></span>
                </span>
                <span class="text-sm mt-2 opacity-70">jours</span>
            </div>
            {% if not event.isDateOnly %}
            <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
                <span class="countdown font-mono text-5xl md:text-6xl">
                    <span id="up-hours" style="--value:0;"></span>
                </span>
                <span class="text-sm mt-2 opacity-70">heures</span>
            </div>
            <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
                <span class="countdown font-mono text-5xl md:text-6xl">
                    <span id="up-minutes" style="--value:0;"></span>
                </span>
                <span class="text-sm mt-2 opacity-70">minutes</span>
            </div>
            <div class="countdown-box flex flex-col items-center bg-base-200 rounded-box p-4 min-w-24">
                <span class="countdown font-mono text-5xl md:text-6xl">
                    <span id="up-secondes" style="--value:0;"></span>
                </span>
                <span class="text-sm mt-2 opacity-70">secondes</span>
            </div>
            {% endif %}
        </div>
    </div>

    <div id="fun-stats-past" class="hidden invisible text-center mt-8 mb-8 px-4 max-w-2xl mx-auto">
        <p class="text-lg opacity-80">
            Soit <span id="past-hours" class="font-bold">0</span> heures,
            ou <span id="past-seconds" class="font-bold">0</span> secondes depuis !
        </p>
        <div class="flex flex-wrap justify-center gap-3 mt-4">
            <span class="badge badge-lg gap-1">😴 <span id="past-sleeps" class="font-bold">0</span> dodos</span>
            <span class="badge badge-lg gap-1">☕ <span id="past-coffees" class="font-bold">0</span> cafés</span>
            <span class="badge badge-lg gap-1">📺 <span id="past-episodes" class="font-bold">0</span> épisodes</span>
            <span class="badge badge-lg gap-1">🍕 <span id="past-pizzas" class="font-bold">0</span> pizzas</span>
            <span class="badge badge-lg gap-1">🎵 <span id="past-songs" class="font-bold">0</span> chansons</span>
            <span class="badge badge-lg gap-1">🚶 <span id="past-walks" class="font-bold">0</span> km à pied</span>
        </div>
    </div>

    <div class="text-center mb-8 px-4">
        <button id="like-btn"
                data-url="{{ path('event_like', {slug: event.slug}) }}"
                data-liked="{{ hasLiked ? '1' : '0' }}"
                class="btn btn-lg gap-2 {{ hasLiked ? 'btn-error' : 'btn-outline' }} transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="{{ hasLiked ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="2" class="w-6 h-6 like-icon transition-transform">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
            </svg>
            <span id="like-count">{{ event.likesCount }}</span>
        </button>
    </div>

    <div class="text-center mb-16 px-4">
        <p class="text-sm opacity-60 mb-3">Partager ce compte à rebours</p>
        <div class="flex flex-wrap justify-center gap-2">
            <button id="copy-link" class="btn btn-sm btn-outline gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9.75a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
                </svg>
                <span>Copier le lien</span>
            </button>
            <a href="https://wa.me/?text={{ url('event_view', {slug: event.slug})|url_encode }}" target="_blank" class="btn btn-sm btn-outline gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                WhatsApp
            </a>
            <a href="https://twitter.com/intent/tweet?url={{ url('event_view', {slug: event.slug})|url_encode }}&text={{ ('Compte à rebours : ' ~ event.label)|url_encode }}" target="_blank" class="btn btn-sm btn-outline gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                X
            </a>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ url('event_view', {slug: event.slug})|url_encode }}" target="_blank" class="btn btn-sm btn-outline gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
                Facebook
            </a>
        </div>
    </div>

    <div class="grid md:grid-cols-4 sm:grid-cols-1 mt-20 px-4 md:px-0">
        <div class="md:col-start-2 md:col-span-2">
            {% if event.description %}
                <h4 class="text-md">Détails</h4>
                <div class="divider mt-1"></div>
                <p>
                    {{ event.description | nl2br }}
                    <br/><br/>
                </p>
            {% endif %}
        </div>
    </div>

    <div class="grid md:grid-cols-4 sm:grid-cols-1 mt-10 px-4 md:px-0">
        <div class="md:col-start-2 md:col-span-2">
            <h4 class="text-md flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
                </svg>
                Livre d'or ({{ comments|length }})
            </h4>
            <div class="divider mt-1"></div>

            {% for flash in app.flashes('success') %}
                <div class="alert alert-success mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span>{{ flash }}</span>
                </div>
            {% endfor %}
            {% for flash in app.flashes('error') %}
                <div class="alert alert-error mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span>{{ flash }}</span>
                </div>
            {% endfor %}

            <form action="{{ path('event_comment', {slug: event.slug}) }}" method="POST" class="mb-8">
                <div class="flex flex-col gap-3">
                    <textarea name="content" placeholder="Votre message..." maxlength="500" rows="3" required
                              class="textarea textarea-bordered w-full"></textarea>
                    <div class="flex items-center gap-3">
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                            </svg>
                            Envoyer
                        </button>
                        <span class="text-xs opacity-60">Un pseudo anonyme vous sera attribué</span>
                    </div>
                </div>
            </form>

            {% if comments|length > 0 %}
                <div class="space-y-4">
                    {% for comment in comments %}
                        <div class="bg-base-200 rounded-lg p-4">
                            <div class="flex justify-between items-start mb-2">
                                <span class="font-semibold">{{ comment.authorOrDefault }}</span>
                                <span class="text-xs opacity-60">{{ comment.createdAt|date('d/m/Y H:i') }}</span>
                            </div>
                            <p class="text-sm">{{ comment.content|nl2br }}</p>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-center opacity-60 py-8">Aucun message pour le moment. Soyez le premier !</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
